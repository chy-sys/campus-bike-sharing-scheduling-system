page {
  background: #f5f7fa;
  font-size: 28rpx;
  color: #303133;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.muted {
  color: #909399;
  font-size: 26rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
}

.stat {
  width: 33.33%;
  padding: 20rpx 0;
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: #909399;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #409eff;
  margin-top: 8rpx;
}

.btn {
  background: #409eff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  padding: 16rpx 0;
  text-align: center;
  margin-top: 20rpx;
}

.btn-primary {
  background: #409eff;
}

.btn-success {
  background: #67c23a;
}

.btn-warn {
  background: #e6a23c;
}

.btn-danger {
  background: #f56c6c;
}

.btn-plain {
  background: #fff;
  color: #409eff;
  border: 2rpx solid #409eff;
}

.btn-small {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: #ecf5ff;
  color: #409eff;
}

.tag-warn {
  background: #fdf6ec;
  color: #e6a23c;
}

.tag-ok {
  background: #f0f9eb;
  color: #67c23a;
}

.tag-gray {
  background: #f4f4f5;
  color: #909399;
}

.input {
  background: #fff;
  border: 2rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #909399;
  font-size: 26rpx;
}
